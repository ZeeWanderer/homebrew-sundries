#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Manage formula update PRs for this Homebrew tap.

Usage:
  ./tap list
  ./tap bump
  ./tap close PR
  ./tap publish PR

Commands:
  list        List open formula update PRs created by brew bump.
  bump        Run brew bump now. It checks formula sources and opens update PRs.
  close PR    Close an unwanted formula update PR and delete its branch.
  publish PR  Verify PR checks, then publish its bottles and merge it into master.

Environment:
  GH_REPO  tap repository override
EOF
}

repo_name() {
  if [[ -n "${GH_REPO:-}" ]]; then
    printf '%s\n' "$GH_REPO"
  else
    gh repo view --json nameWithOwner --jq .nameWithOwner
  fi
}

case "${1:-}" in
  list)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    repo="$(repo_name)"
    prs="$(gh pr list --repo "$repo" --state open --limit 100 \
      --json number,title,headRefName,url \
      --jq '.[] | select(.headRefName | startswith("bump-")) | "#\(.number)  \(.title)  \(.url)"')"
    if [[ -n "$prs" ]]; then
      printf '%s\n' "$prs"
    else
      printf 'No open formula update PRs.\n'
    fi
    ;;
  bump)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    repo="$(repo_name)"
    gh workflow run autobump.yml --repo "$repo"
    printf 'Started formula bump: https://github.com/%s/actions/workflows/autobump.yml\n' "$repo"
    ;;
  close)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    repo="$(repo_name)"
    pr="$2"
    read -r state branch title < <(gh pr view "$pr" --repo "$repo" \
      --json state,headRefName,title \
      --jq '[.state, .headRefName, .title] | @tsv')
    [[ "$state" == OPEN ]] || { printf 'PR %s is not open\n' "$pr" >&2; exit 1; }
    [[ "$branch" == bump-* ]] || {
      printf 'PR %s is not a formula update PR (%s)\n' "$pr" "$branch" >&2
      exit 1
    }
    printf 'Close PR %s (%s)? [y/N] ' "$pr" "$title"
    read -r answer
    [[ "$answer" == y || "$answer" == Y ]] || exit 1
    gh pr close "$pr" --repo "$repo" --delete-branch
    ;;
  publish)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    repo="$(repo_name)"
    pr="$2"
    state="$(gh pr view "$pr" --repo "$repo" --json state --jq .state)"
    [[ "$state" == OPEN ]] || { printf 'PR %s is not open\n' "$pr" >&2; exit 1; }
    head_sha="$(gh pr view "$pr" --repo "$repo" --json headRefOid --jq .headRefOid)"
    gh pr checks "$pr" --repo "$repo"
    printf 'Publish PR %s at %s? [y/N] ' "$pr" "$head_sha"
    read -r answer
    [[ "$answer" == y || "$answer" == Y ]] || exit 1
    gh workflow run publish.yml --repo "$repo" \
      -f "pull_request=$pr" \
      -f "head_sha=$head_sha"
    printf 'Started bottle publication: https://github.com/%s/actions/workflows/publish.yml\n' "$repo"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
